PORT=3000
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/onitama?retryWrites=true&w=majority
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Uno o varios orígenes separados por comas, sin espacios ni barra final al terminar:
# FRONTEND_ORIGIN=http://localhost:5173,https://tfg-onitama-psi.vercel.app,https://tfg-onitama-git-develop-usuario.vercel.app
FRONTEND_ORIGIN=http://localhost:5173
# Dirección de correo verificada como remitente en Brevo -- ya no se usa para SMTP.
GMAIL_USER=
# Clave de API de Brevo (SMTP & API -> API Keys en brevo.com).
BREVO_API_KEY=
TURNSTILE_SECRET_KEY=